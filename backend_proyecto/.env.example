# Copiar como .env y completar los valores. No subir .env a Git.
DB_URL=jdbc:postgresql://db:5432/predicciones_db
DB_USERNAME=app_user
# Si se reutiliza una base existente, conservar su contrasena actual.
DB_PASSWORD=REEMPLAZAR_POR_CONTRASENA_LOCAL
# Generar una clave aleatoria de al menos 32 caracteres.
JWT_SECRET=REEMPLAZAR_POR_CLAVE_ALEATORIA
# Clave de la cuenta autorizada de API-Sports. Puede quedar vacia si no se usa.
API_SPORTS_KEY=
